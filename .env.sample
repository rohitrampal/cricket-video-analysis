# Copy to project root and edit:  cp .env.sample .env
# config.py loads .env via python-dotenv (optional; install from requirements.txt).

# Ball YOLO weights (Ultralytics). Same default as config.BALL_YOLO_MODEL_PATH:
# local file under the repo, or a hub id like yolov8n.pt.
# If models/yolov8n.pt is missing, resolve_ball_yolo_model_path() falls back to hub yolov8n.pt.
BALL_YOLO_MODEL_PATH=models/yolov8n.pt
